# 依赖忽略：本项目零 Composer 依赖，无 vendor
/data/
!/data/.gitkeep
/uploads/
!/uploads/.gitkeep
# 站点配置属于部署环境（含本机绝对路径），不纳入源码仓库
/nginx-server.conf
# 插件目录纳入源码仓库（v1.2.15 撤销 v1.0.45 的 /plugins/ 整目录排除）。
# 原因：整目录排除使 13 个插件的源码完全依赖本机，git clone / clean / 换机即永久丢失，
# 而插件与核心同为产品代码、且相互耦合（插件 CSS 会经 ?action=assets&type=css
# 影响前台样式），不同步版本无法定位回归。
# 仅排除插件目录内的运行时产物（上传文件、缓存、日志），代码与 plugin.json 一律入库。
plugins/**/uploads/
plugins/**/cache/
plugins/**/*.log
*.log
.DS_Store
Thumbs.db


# 工作区内部资料
/.workbuddy/

# 测试临时文件
*.tmp

# 根目录验证截图（浏览器回归产物，如 v110-dm.png）不属于源码
/*.png
